DROP TABLE IF EXISTS FeePayments;

CREATE TABLE FeePayments (
    payment_id INT PRIMARY KEY,
    student_name VARCHAR(100) NOT NULL,
    amount DECIMAL(10, 2) NOT NULL,
    CONSTRAINT chk_amount CHECK (amount > 0),
    payment_date DATE
);

-- This transaction was already successful.
START TRANSACTION;
INSERT INTO FeePayments (payment_id, student_name, amount, payment_date) VALUES
(1, 'Ashish', 5000.00, '2025-09-27'),
(2, 'Smaran', 4500.00, '2025-09-27'),
(3, 'Vaibhav', 5500.00, '2025-09-26');
COMMIT;

-- Verifying the first successful transaction.
SELECT * FROM FeePayments;

-- This transaction is now fixed with a positive amount and changed to COMMIT.
START TRANSACTION;
